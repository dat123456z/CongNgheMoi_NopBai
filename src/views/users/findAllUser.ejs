<body>
    <style>
        table.user-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
        }

        table.user-table th,
        table.user-table td {
            border: 1px solid #ccc;
            padding: 8px 12px;
            text-align: center;
            vertical-align: middle;
            word-break: break-word;
        }

        table.user-table th:nth-child(1),
        table.user-table td:nth-child(1) {
            width: 34%;
        }

        table.user-table th:nth-child(2),
        table.user-table td:nth-child(2),
        table.user-table th:nth-child(3),
        table.user-table td:nth-child(3) {
            width: 16%;
        }

        table.user-table th:nth-child(4),
        table.user-table td:nth-child(4) {
            width: 20%;
        }

        table.user-table th:nth-child(5),
        table.user-table td:nth-child(5) {
            width: 14%;
        }
    </style>
    <table class="user-table">
        <tr>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
        <% for(let i=0; i < datalist.length; i++) { %>
            <tr>
                <td>
                    <%= datalist[i].email %>
                </td>
                <td>
                    <%= datalist[i].firstName %>
                </td>
                <td>
                    <%= datalist[i].lastName %>
                </td>
                <td>
                    <%= datalist[i].address %>
                </td>
                <td>
                    <a href="/edit-crud?id=<%= datalist[i].id %>">Edit</a> |
                    <a href="/delete-crud?id=<%= datalist[i].id %>">Delete</a>
                </td>
            </tr>
            <% } %>
    </table>
</body>